PROC 0
/* Run after receiving the outer XMIT into userid.CATMAP.XMILIB. */
CONTROL NOFLUSH PROMPT
IF &SYSDSN('&SYSUID..CATMAP.LOADLIB') = OK THEN DO
  WRITE &SYSUID..CATMAP.LOADLIB ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
IF &SYSDSN('&SYSUID..CATMAP.JCLLIB') = OK THEN DO
  WRITE &SYSUID..CATMAP.JCLLIB ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
IF &SYSDSN('&SYSUID..CATMAP.SOURCE') = OK THEN DO
  WRITE &SYSUID..CATMAP.SOURCE ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
RECEIVE INDATASET('&SYSUID..CATMAP.XMILIB(LOADLIB)')
DATA PROMPT
  DATASET('&SYSUID..CATMAP.LOADLIB')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
RECEIVE INDATASET('&SYSUID..CATMAP.XMILIB(JCLLIB)')
DATA PROMPT
  DATASET('&SYSUID..CATMAP.JCLLIB')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
RECEIVE INDATASET('&SYSUID..CATMAP.XMILIB(SOURCE)')
DATA PROMPT
  DATASET('&SYSUID..CATMAP.SOURCE')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
WRITE CATMAP INSTALLED: &SYSUID..CATMAP.LOADLIB, JCLLIB, SOURCE.
EXIT CODE(0)
