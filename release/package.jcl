//CATPACK JOB (SOF),'PACKAGE CATMAP',CLASS=A,MSGCLASS=Y,
//         NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//LOAD     EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..CATMAP.XMILIB(LOADLIB),DISP=SHR
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..CATMAP.LOADLIB') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
//JCL      EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..CATMAP.XMILIB(JCLLIB),DISP=SHR
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..CATMAP.JCLLIB') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
//SOURCE   EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..CATMAP.XMILIB(SOURCE),DISP=SHR
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..CATMAP.SOURCE') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
//OUTER    EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..CATMAP.XMI,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..CATMAP.XMILIB') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
