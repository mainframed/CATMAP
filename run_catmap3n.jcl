//CATMAPNR JOB (SOF),'RUN CATMAP3N',CLASS=A,MSGCLASS=Y,
//         NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//* Change the PARM host to a listener reachable from the LPAR.
//TSO      EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=&SYSUID..CATMAP.LOADLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 CALL '&SYSUID..CATMAP.LOADLIB(CATMAP3N)' '127.0.0.1 4444'
/*
