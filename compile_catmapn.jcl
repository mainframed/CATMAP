//CATMAPNC JOB (SOF),'COMPILE CATMAP3N',CLASS=A,MSGCLASS=Y,
//         NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//         SET FILE=CATMAP3N
//         SET SRCPDS=&SYSUID..CATMAP.SOURCE
//         SET OUTPDS=&SYSUID..CATMAP.LOADLIB
//         SET LINKLIB=SYS1.LINKLIB
//         SET MACLIB=SYS1.MACLIB
//         SET TCPMAC=TCPIP.SEZACMAC
//         SET TCPLIB=TCPIP.SEZATCP
//* PARM at run time: ###.###.###.### port
//ASSEMBLY EXEC PGM=ASMA90,PARM='OBJECT,NODECK'
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSIN    DD  DSN=&SRCPDS(&FILE),DISP=SHR
//SYSLIB   DD  DSN=&MACLIB,DISP=SHR
//         DD  DSN=&TCPMAC,DISP=SHR
//SYSUT1   DD  UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSLIN   DD  DSN=&&OBJ,DISP=(NEW,PASS),
//             UNIT=SYSALLDA,SPACE=(CYL,(1,1)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//LINK     EXEC PGM=HEWL,PARM='MAP,LIST',COND=(4,LT,ASSEMBLY)
//SYSLIN   DD  DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD  DDNAME=SYSIN
//SYSLMOD  DD  DSN=&OUTPDS(&FILE),DISP=SHR
//SYSUT1   DD  UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSLIB   DD  DSN=&LINKLIB,DISP=SHR
//         DD  DSN=&TCPLIB,DISP=SHR
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
 INCLUDE SYSLIB(IGGCSI00)
 NAME CATMAP3N(R)
/*
