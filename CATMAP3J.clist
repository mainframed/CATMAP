PROC 0 HLQ()
/* HLQ selects the output prefix; code runs from your LOADLIB. */
CONTROL NOFLUSH
IF &LENGTH(&HLQ) = 0 THEN SET &HLQ = &SYSUID
ALLOC DD(CATOUT) DATASET('&HLQ..CATMAP.OUTPUT') NEW CATALOG +
      DSORG(PS) RECFM(F B) LRECL(80) BLKSIZE(0) +
      SPACE(2,2) CYLINDERS UNIT(SYSALLDA)
IF &LASTCC NE 0 THEN DO
  SET &RC = &LASTCC
  WRITE ERROR: FAILED TO ALLOCATE &HLQ..CATMAP.OUTPUT RC=&RC
  EXIT CODE(&RC)
END
CALL '&SYSUID..CATMAP.LOADLIB(CATMAP3J)'
SET &RC = &LASTCC
FREE DD(CATOUT)
IF &RC NE 0 THEN WRITE ERROR: CATMAP3J ENDED WITH RC=&RC
EXIT CODE(&RC)
